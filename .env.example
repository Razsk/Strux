# Google Gemini API Key (Required for live AI schema design, extraction, and context queries)
# You can also configure this directly in the Strux UI (Settings / API Key modal)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 3001 in dev, serves frontend in production)
PORT=3001

# SQLite Database Path (Default: ./data/strux.db)
DB_PATH=./data/strux.db
